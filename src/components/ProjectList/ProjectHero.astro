---
import type { ProjectData } from "#base/lib/project-media";

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
---

<header class="project-hero">
  <a class="project-hero__back" href="/projects/">← All projects</a>
  <div class="project-hero__heading">
    <p class="project-hero__meta">
      <span class="eyebrow">{project.category}</span>
      <span>{project.projectType}</span>
      {project.period && <span>{project.period}</span>}
      {project.status && <span class="tag">{project.status}</span>}
    </p>
    <h1>{project.title}</h1>
    <p class="project-hero__summary">{project.summary}</p>
    <dl class="project-hero__role">
      <dt>My role</dt>
      <dd>{project.role}</dd>
    </dl>
  </div>
  <div class="project-hero__tools">
    <ul class="tag-list" aria-label="Core technologies">
      {project.techStack.map((tech) => <li>{tech}</li>)}
    </ul>
    {project.links.length > 0 && (
      <div class="project-hero__links">
        {project.links.map(({ label, url }) => <a class="action-link" href={url}>{label} ↗</a>)}
      </div>
    )}
  </div>
</header>

<style>
  .project-hero {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .project-hero__back {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: var(--control-height);
    font-size: var(--size-sm);
    text-decoration: none;
  }

  .project-hero__back:hover {
    text-decoration: underline;
  }

  .project-hero__heading {
    display: grid;
    gap: var(--space-4);
  }

  .project-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    color: var(--text-muted);
    font-size: var(--size-sm);
  }

  .project-hero__summary {
    max-width: 70ch;
    color: var(--text-secondary);
    font-size: var(--size-lead);
  }

  .project-hero__role {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    font-size: var(--size-sm);
  }

  .project-hero__role dt {
    color: var(--text-muted);
  }

  .project-hero__role dd {
    margin: 0;
    color: var(--text-secondary);
  }

  .project-hero__tools,
  .project-hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .project-hero__tools {
    justify-content: space-between;
    gap: var(--space-4);
  }

  @media (max-width: 600px) {
    .project-hero__heading h1 {
      font-size: clamp(var(--size-h2), 9vw, var(--size-h1));
    }

    .project-hero__summary {
      font-size: var(--size-body);
    }
  }
</style>
