---
import type { CollectionEntry } from "astro:content";
import ExperienceHighlights from "./ExperienceHighlights.astro";

interface Props {
  experience: CollectionEntry<"experience">;
}

const { experience } = Astro.props;
const {
  jobTitle,
  company,
  location,
  startDate,
  endDate,
  bullets,
  techStack = [],
  highLights = [],
  logo,
  referenceLetter,
} = experience.data;

const initials = company
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<section class="experience-section" aria-labelledby="featured-experience-heading">
  <div class="section-heading">
    <p>Featured Role</p>
    <h2 id="featured-experience-heading">Selected work with measurable impact</h2>
  </div>

  <article class="featured-card">
    <div class="featured-main">
      <div class="logo" aria-hidden={!logo}>
        {logo ? <img src={logo.src} alt={`${company} logo`} loading="lazy" /> : <span>{initials}</span>}
      </div>

      <div>
        <p class="role-label">Featured Experience</p>
        <h3>{jobTitle}</h3>
        <p class="company">{company}</p>
      </div>

      <div class="meta">
        <span>{startDate} - {endDate || "Present"}</span>
        {location && <span>{location}</span>}
      </div>

      <p class="summary">{bullets[0]}</p>

      {
        techStack.length > 0 && (
          <div class="tech-list" aria-label={`${company} technology stack`}>
            {techStack.filter(Boolean).map((tech) => <span>{tech}</span>)}
          </div>
        )
      }

      {
        referenceLetter && (
          <a class="reference-link" href={referenceLetter.path} target="_blank" rel="noreferrer">
            View Reference Letter
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>

    <ExperienceHighlights highlights={highLights} title="Impact Snapshot" />
  </article>
</section>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background:
      linear-gradient(135deg, rgba(139, 156, 255, 0.12), transparent 32%),
      linear-gradient(180deg, var(--card), var(--surface));
    box-shadow: var(--shadow-lg);
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .featured-main {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .logo {
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: linear-gradient(135deg, rgba(139, 156, 255, 0.22), rgba(45, 212, 191, 0.14));
    color: var(--text);
    font-weight: 800;
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.35rem;
  }

  .role-label,
  .company,
  .summary {
    margin: 0;
  }

  .role-label {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0.35rem 0 0;
    color: var(--text);
    font-size: clamp(1.65rem, 4vw, 3rem);
    line-height: 1;
  }

  .company {
    margin-top: 0.45rem;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .meta,
  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta span,
  .tech-list span {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(10, 15, 24, 0.35);
    color: var(--text-secondary);
    padding: 0.35rem 0.7rem;
    font-size: 0.88rem;
  }

  .summary {
    max-width: 48rem;
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .reference-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .reference-link:hover,
  .reference-link:focus-visible {
    color: var(--accent);
  }

  @media (max-width: 840px) {
    .featured-card {
      grid-template-columns: 1fr;
    }
  }
</style>
