---
import { site } from "../config/site";

const { username, social } = site;
const githubUrl = social.github
  ? `https://github.com/${social.github}`
  : undefined;
---

<footer class="footer">
  <div class="container">
    <p>
      Built with Astro and <span class="love" aria-hidden="true">&hearts;</span> by
      {
        githubUrl ? (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer">
            {username}
          </a>
        ) : (
          username
        )
      }
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 1.25rem;
    background-color: var(--bg);
    color: var(--text-secondary);
    text-align: center;
  }

  .footer a {
    color: var(--primary);
  }

  .love {
    color: #ff6b6b;
  }
</style>
