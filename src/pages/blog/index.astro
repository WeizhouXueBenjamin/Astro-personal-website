---
import { getBlogPath, getPublishedPosts } from "#base/lib/content";
import MainLayout from "#layouts/MainLayout.astro";

const posts = await getPublishedPosts();
---

<MainLayout title="Blog" description="Notes on automation, control systems, software, and engineering practice." contentWidth="text">
  <p class="intro">Notes on automation, control systems, software, and engineering practice.</p>
  {posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <article class="surface-card">
            <h2><a href={getBlogPath(post.id)}>{post.data.title}</a></h2>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("en-NZ", { year: "numeric", month: "short", day: "2-digit", timeZone: "UTC" })}
            </time>
            <p>{post.data.description}</p>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty-state">No articles published yet. Engineering notes and project write-ups will appear here.</p>
  )}
</MainLayout>

<style>
.intro {
    color: var(--text-secondary);
  }

  .post-list {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  article {
    display: grid;
    gap: var(--space-3);
    padding: var(--card-padding);
  }

  h2 {
    font-size: var(--size-h3);
  }

  time {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--size-sm);
  }

  article p {
    color: var(--text-secondary);
  }
</style>
