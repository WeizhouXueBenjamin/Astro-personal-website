---
const { exp } = Astro.props;
const { jobTitle, company, startDate, endDate, location, tags, bullets, techStack } =
  exp.data;

const filterTags = JSON.stringify(tags ?? []);
---

<div class="experience-card" data-filter-tags={filterTags}>
  {/* Header */}
  <div class="mb-4">
    <h3 class="text-xl font-bold">
      {jobTitle} @ {company}
    </h3>
    <p class="text-sm text-gray-300">
      {startDate} — {endDate || "Present"}
      {location && ` • ${location}`}
    </p>
  </div>

  {/* Bullet Points */}
  <ul class="list-disc pl-5 space-y-2">
    {bullets.map((bullet: string[]) => <li class="text-white">{bullet}</li>)}
  </ul>

  {/* Optional: Tech Stack */}
  {
    techStack?.length > 0 && (
      <div class="mt-3 text-sm text-gray-300 font-bold">
        Tech: {techStack.join(" • ")}
      </div>
    )
  }
  
</div>

<style>
  @reference "../../styles/global.css";
  .experience-card {
    @apply border-l-4 border-blue-500 pl-6 py-2 transition hover:bg-gray-800;
  }

  .experience-card[hidden] {
    display: none;
  }
</style>
