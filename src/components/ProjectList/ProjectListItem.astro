---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel: Heading = "h2" } = Astro.props;
const {
  title,
  subtitle,
  description,
  githubUrl,
  liveUrl,
  demoUrl,
  year,
  status,
  bullets,
  tags,
  techStack = [],
  logo,
} = project.data;

const links = [
  { label: "GitHub", href: githubUrl },
  { label: "Live site", href: liveUrl },
  { label: "Watch demo", href: demoUrl },
].filter((link): link is { label: string; href: string } => Boolean(link.href));
const hasMoreDetails = bullets.length > 2;
const visibleBullets = hasMoreDetails ? [bullets[0], bullets[bullets.length - 1]] : bullets;
const extraBullets = hasMoreDetails ? bullets.slice(1, -1) : [];
---

<article class="project-item surface-card" data-filter-tags={JSON.stringify(tags)}>
  <div class="project-content">
    {logo && (
      <img
        class="project-logo"
        src={logo.src}
        width="64"
        height="64"
        alt={`${title} logo`}
        loading="lazy"
      />
    )}
    <div class="project-meta technical-meta">
      {year && <span>{year}</span>}
      {status && (
        <span
          class:list={[
            "tag",
            {
              "tag--success": status === "Completed",
              "tag--warning": status === "In Progress",
            },
          ]}
        >{status}</span>
      )}
    </div>
    <Heading>{title}</Heading>
    {subtitle && <p class="subtitle technical-meta">{subtitle}</p>}
    <p class="project-description">{description}</p>
    {tags.length > 0 && (
      <ul class="project-tags tag-list" aria-label={`${title} topics`}>
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
    <p class="detail-label">Implementation & verification</p>
    {hasMoreDetails ? (
      <div class="bullet-disclosure">
        <ul class="project-bullets bullet-disclosure__preview">
          {visibleBullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        <details class="detail-disclosure">
          <summary>
            <span class="detail-disclosure__closed">More implementation details ({extraBullets.length})</span>
            <span class="detail-disclosure__open">Show less</span>
          </summary>
          <ul class="project-bullets">
            {bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </details>
      </div>
    ) : (
      <ul class="project-bullets">
        {bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    )}
    {techStack.length > 0 && (
      <ul class="tech-stack tag-list" aria-label={`${title} technology stack`}>
        {techStack.map((tech) => <li>{tech}</li>)}
      </ul>
    )}
  </div>
  {links.length > 0 && (
    <div class="project-links">
      {links.map((link) => (
        <a class="action-link" href={link.href} target="_blank" rel="noopener noreferrer">
          {link.label} ↗
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .project-item {
    display: flex;
    flex-direction: column;
  }

  .project-content {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--card-padding);
  }

  .project-logo {
    object-fit: contain;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  h2,
  h3 {
    font-size: var(--size-h3);
  }

  .project-description,
  .project-bullets {
    color: var(--text-secondary);
  }

  .detail-label {
    margin-top: var(--space-2);
    color: var(--text);
    font-size: var(--size-sm);
    font-weight: var(--weight-control);
  }

  .project-bullets {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-left: var(--space-5);
    list-style: disc;
  }

  .project-bullets li::marker {
    color: var(--text-muted);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: auto;
    padding: 0 var(--card-padding) var(--card-padding);
  }
</style>
