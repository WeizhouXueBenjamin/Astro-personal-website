---
import { getBlogPath, getPublishedPosts } from "#base/lib/content";
import MainLayout from "#layouts/MainLayout.astro";
import { withBase } from "#base/lib/paths";

const posts = await getPublishedPosts();
---

<MainLayout
  title="Blog"
  description="Notes on automation, control systems, software, and engineering practice."
>
  <p class="page-intro">Notes on automation, control systems, software, and engineering practice.</p>
  {posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post, index) => (
        <li>
          <article>
            <a class="post-link" href={getBlogPath(post.id)} aria-labelledby={`post-title-${index}`}>
              <div class="post-context">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-NZ", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                    timeZone: "UTC",
                  })}
                </time>
                {post.data.tags.length > 0 && (
                  <ul class="tag-list" aria-label="Topics">
                    {post.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </div>
              <div class="post-summary">
                <h2 id={`post-title-${index}`}>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <span class="post-action" aria-hidden="true">Read article →</span>
              </div>
            </a>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <div class="empty-state blog-empty">
      <p>No articles published yet. Engineering notes and project write-ups will appear here.</p>
      <a href={withBase("/projects/")}>Explore projects →</a>
    </div>
  )}
</MainLayout>

<style>
  .post-list {
    margin: var(--space-7) 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .post-list > li {
    border-bottom: 1px solid var(--border);
  }

  .post-link {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-6);
    color: var(--text);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: background-color var(--duration-fast) ease;
  }

  .post-link:hover,
  .post-link:focus-visible {
    background: var(--surface);
  }

  .post-link:hover h2,
  .post-link:focus-visible h2 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .post-context,
  .post-summary {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    min-width: 0;
  }

  .post-summary h2 {
    max-width: var(--content-copy);
    font-size: var(--size-h2);
    text-wrap: pretty;
  }

  time {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--size-sm);
  }

  .post-summary p {
    max-width: var(--content-copy);
    color: var(--text-secondary);
  }

  .post-action {
    color: var(--accent);
    font-size: var(--size-sm);
    font-weight: var(--weight-control);
  }

  .blog-empty {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-left: var(--space-5);
    border-left: 1px solid var(--border-control);
  }

  @media (max-width: 700px) {
    .post-link {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .post-context {
      gap: var(--space-3);
    }
  }
</style>
