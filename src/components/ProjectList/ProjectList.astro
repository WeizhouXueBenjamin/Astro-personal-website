---
import { getProjects } from "#base/lib/content";
import Filter from "../basic/filter.astro";
import ProjectListItem from "./ProjectListItem.astro";

const projects = await getProjects();
const tags = [...new Set(projects.flatMap(({ data }) => data.tags))];
---

{projects.length > 0 ? (
  <>
    <Filter tags={tags} target="project-list" label="Filter projects" />
    <div class="project-list" id="project-list">
      {projects.map((project) => <ProjectListItem project={project} />)}
    </div>
  </>
) : (
  <p class="empty-state">Project write-ups will appear here as they become available.</p>
)}

<style>
  .project-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  @media (max-width: 700px) {
    .project-list {
      grid-template-columns: 1fr;
    }
  }
</style>
