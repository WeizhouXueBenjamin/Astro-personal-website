---
import type { CollectionEntry } from "astro:content";
import ExperienceHighlights from "./ExperienceHighlights.astro";

interface Props {
  experience: CollectionEntry<"experience">;
}

const { experience } = Astro.props;
const {
  jobTitle,
  company,
  location,
  startDate,
  endDate,
  bullets,
  techStack = [],
  highLights = [],
  logo,
  companyWebsite,
} = experience.data;

const initials = company
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<article class="experience-card surface-card">
  <header>
    <div class="logo" aria-hidden={!logo}>
      {logo ? <img src={logo.src} alt={`${company} logo`} loading="lazy" /> : <span>{initials}</span>}
    </div>
    <div class="title-group">
      <h3>{jobTitle}</h3>
      {
        companyWebsite ? (
          <a href={companyWebsite} target="_blank" rel="noreferrer">{company}</a>
        ) : (
          <p>{company}</p>
        )
      }
    </div>
  </header>

  <div class="meta">
    <span class="tag">{startDate} - {endDate || "Present"}</span>
    {location && <span class="tag">{location}</span>}
  </div>

  <ul class="impact-list" aria-label={`${company} responsibilities`}>
    {bullets.map((bullet) => <li>{bullet}</li>)}
  </ul>

  {
    techStack.length > 0 && (
      <div class="tech-stack" aria-label={`${company} technology stack`}>
        <h4>Tech Stack</h4>
        <div class="tag-list">
          {techStack.filter(Boolean).map((tech) => (
            <span class="tag">{tech}</span>
          ))}
        </div>
      </div>
    )
  }

  <ExperienceHighlights highlights={highLights} />
</article>

<style>
.experience-card {
    display: grid;
    gap: var(--space-5);
    padding: var(--card-padding);
  }

  header {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }

  .logo {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--size-sm);
    font-weight: var(--weight-control);
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-2);
  }

  .title-group {
    min-width: 0;
  }

  .title-group p,
  .title-group a {
    display: inline-block;
    margin-top: var(--space-1);
    color: var(--text-secondary);
    font-size: var(--size-sm);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .impact-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-left: var(--space-5);
    color: var(--text-secondary);
    list-style: disc;
  }

  .impact-list li::marker {
    color: var(--text-muted);
  }

  .tech-stack {
    display: grid;
    gap: var(--space-3);
  }

  h4 {
    font-size: var(--size-sm);
  }
</style>
