---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import ProjectHero from "#components/ProjectList/ProjectHero.astro";
import ProjectSection from "#components/ProjectList/ProjectSection.astro";
import ProjectFigure from "#components/ProjectList/ProjectFigure.astro";
import ProjectGallery from "#components/ProjectList/ProjectGallery.astro";
import ProjectTest from "#components/ProjectList/ProjectTest.astro";
import Layout from "./Layout.astro";
import { withBase } from "#base/lib/paths";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project: entry } = Astro.props;
const project = entry.data;
const { Content, remarkPluginFrontmatter } = await render(entry);
const sections = remarkPluginFrontmatter.projectSections as { id: string; title: string }[];
if (!sections?.length) throw new Error(`Missing project sections: ${entry.id}`);
---

<Layout title={project.title} description={project.summary}>
  <main class="project-detail container">
    <ProjectHero project={project} evidence={project.hero ? { media: project.hero, number: 1 } : undefined} />
    <nav class="project-detail__contents" aria-label="Case study sections">
      <p class="eyebrow">In this case study</p>
      <ol>
        {sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
      </ol>
    </nav>
    <Content components={{ ProjectSection, Figure: ProjectFigure, Gallery: ProjectGallery, Test: ProjectTest }} />
    <footer class="project-detail__footer">
      <a class="action-link" href={withBase("/projects/")}>← Explore all projects</a>
      <a href={withBase("/about/")}>About my background →</a>
    </footer>
  </main>
</Layout>

<style>
  .project-detail {
    padding-block: var(--header-offset) var(--space-7);
    overflow-wrap: anywhere;
  }

  .project-detail__contents {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--space-7);
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .project-detail__contents ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--size-sm);
  }

  .project-detail__contents a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  .project-detail__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 800px) {
    .project-detail__contents {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
