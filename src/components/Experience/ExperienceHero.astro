---
import ExperienceStats from "./ExperienceStats.astro";

interface Props {
  rolesCount: number;
  yearsLabel: string;
  techCount: number;
}

const { rolesCount, yearsLabel, techCount } = Astro.props;

const stats = [
  {
    value: rolesCount,
    label: "Roles",
    detail: "Across product and infrastructure teams.",
  },
  {
    value: yearsLabel,
    label: "Experience",
    detail: "Hands-on delivery across live systems and teams.",
  },
  {
    value: `${techCount}+`,
    label: "Technologies",
    detail: "technologies used in production and team projects.",
  },
];
---

<section class="experience-hero" aria-labelledby="experience-hero-heading">
  <div class="hero-copy">
    <p class="eyebrow">Professional Experience</p>
    <h2 id="experience-hero-heading">
      Full-stack engineering, and operational support.
    </h2>
    <p class="summary">
      Experience building web applications, automation-minded workflows, and
      reliable technical systems with measurable delivery outcomes.
    </p>
  </div>

  <ExperienceStats stats={stats} />
</section>

<style>
  .experience-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background:
      radial-gradient(circle at 12% 18%, rgba(139, 156, 255, 0.16), transparent 30rem),
      linear-gradient(135deg, var(--surface), var(--bg));
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .hero-copy {
    max-width: 46rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 780;
    line-height: 1;
  }

  .summary {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.65;
  }

  @media (max-width: 920px) {
    .experience-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
