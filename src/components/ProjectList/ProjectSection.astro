---
interface Props {
  id: string;
  title: string;
  index: number;
}

const { id, title, index } = Astro.props;
---

<section class="project-section" id={id} aria-labelledby={`heading-${id}`}>
  <div class="project-section__heading">
    <p class="eyebrow" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
    <h2 id={`heading-${id}`}>{title}</h2>
  </div>
  <div class="project-section__body prose">
    <slot />
  </div>
</section>

<style>
  .project-section {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7);
    border-top: 1px solid var(--border);
    scroll-margin-top: var(--header-offset);
  }

  .project-section__heading {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .project-section__heading h2 {
    font-size: var(--size-h3);
    text-wrap: pretty;
  }

  .project-section__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }

  .project-section__body > :global(p),
  .project-section__body > :global(ul),
  .project-section__body > :global(blockquote) {
    max-width: var(--content-copy);
  }

  .project-section__body > :global(.project-test + .project-test) {
    margin-block-start: 0;
  }

  @media (max-width: 800px) {
    .project-section {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .project-section__heading {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
    }
  }
</style>
