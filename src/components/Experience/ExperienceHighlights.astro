---
interface Props {
  highlights?: string[];
  title?: string;
}

const { highlights = [], title = "Key Achievements" } = Astro.props;
const visibleHighlights = highlights.filter((highlight) => highlight.trim().length > 0);
---

{
  visibleHighlights.length > 0 && (
    <section class="highlights" aria-label={title}>
      <h4>{title}</h4>
      <ul>
        {visibleHighlights.map((highlight) => (
          <li>
            <span aria-hidden="true">✓</span>
            <p>{highlight}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
.highlights {
    display: grid;
    gap: var(--space-3);
  }

  h4 {
    font-size: var(--size-sm);
  }

  ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
    color: var(--text-secondary);
  }

  span {
    display: inline-grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    border-radius: var(--radius-tag);
    background: var(--accent-glow);
    color: var(--accent);
    font-size: var(--size-sm);
    font-weight: var(--weight-control);
  }
</style>
