---
interface Props {
  id: string;
  title: string;
  index: number;
}

const { id, title, index } = Astro.props;
---

<section class="project-section" id={id} aria-labelledby={`heading-${id}`}>
  <div class="project-section__heading">
    <p class="eyebrow" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
    <h2 id={`heading-${id}`}>{title}</h2>
  </div>
  <div class="project-section__body prose">
    <slot />
  </div>
</section>

<style>
  .project-section {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-top: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-offset) + var(--space-4));
  }

  .project-section__heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .project-section__heading h2 {
    font-size: var(--size-h2);
    text-wrap: pretty;
  }

  .project-section__body {
    display: flow-root;
    min-width: 0;
    font-size: var(--size-lead);
  }

  .project-section__body > :global(p),
  .project-section__body > :global(ul),
  .project-section__body > :global(ol),
  .project-section__body > :global(blockquote) {
    max-width: 70ch;
  }

  .project-section__body :global(li + li) {
    margin-top: var(--space-2);
  }

  .project-section__body :global(table) {
    display: block;
  }

  .project-section__body :global(h3) {
    scroll-margin-top: calc(var(--header-offset) + var(--space-4));
  }

  .project-section__body > :global(.project-test + .project-test) {
    margin-block-start: 0;
  }

  @media (max-width: 600px) {
    .project-section__body {
      font-size: var(--size-body);
    }
  }
</style>
