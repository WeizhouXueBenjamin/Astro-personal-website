---
import { getCollection } from "astro:content";
import MainLayout from "#layouts/MainLayout.astro";
import { site } from "#config/site";

const experience = (await getCollection("experience")).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);

const introDescription =
  "I'm a full-stack engineer with 1+ year of production experience delivering React and Node.js applications for charities and university teams. I build practical web products, lead small teams through delivery, and care about performance, accessibility, and clear engineering foundations.";

const studies = [
  {
    title: "Bachelor of Science, Computer Science",
    meta: "University of Auckland / Jan 2023 - Nov 2025",
  },
  {
    title: "Microsoft Certified: Azure Fundamentals",
    meta: "Cloud concepts, core Azure services, security, privacy, and pricing / May 2024",
  },
  {
    title: "Certificate of Merit: Department of Physics",
    meta: "Recognition for logical reasoning, systematic analysis, and attention to detail / Jul 2025",
  },
];

const skills = [
  {
    title: "Full-stack product engineering",
    description:
      "Building production React, Next.js, Node.js, and Firebase systems with practical architecture and measurable delivery outcomes.",
    tools: ["React", "Next.js", "Node.js", "Firebase", "Tailwind CSS"],
  },
  {
    title: "Team delivery and technical leadership",
    description:
      "Leading small engineering teams through planning, implementation, reviews, testing, and handoff without losing sight of product goals.",
    tools: ["REST APIs", "JWT", "RBAC", "Cypress", "MongoDB"],
  },
];

const anchorLinks = [
  { href: "#introduction", label: "Introduction" },
  { href: "#work-experience", label: "Work Experience" },
  { href: "#studies", label: "Studies" },
  { href: "#technical-skills", label: "Technical skills" },
];

const displayTools = (tools: string[] = [], fallback: string[] = []) =>
  (tools.length ? tools : fallback).filter((tool) => tool.trim().length > 1);
---

<MainLayout title="About" description="Learn more about me">
  <div class="about-shell">
    <aside class="about-rail" aria-label="About page sections">
      <nav>
        {anchorLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </aside>

    <article class="about-page">
      <section
        id="introduction"
        class="about-section about-intro"
        aria-labelledby="introduction-title"
      >
        <div class="identity-row">
          <img src="/favicon.svg" alt="" width="56" height="56" />
          <div>
            <p class="eyebrow">{site.userTitle}</p>
            <p class="location">Auckland, New Zealand</p>
          </div>
        </div>

        <h1 id="introduction-title">
          Building fast, useful web products with care for the details.
        </h1>

        <p class="intro-copy">{introDescription}</p>

        <div class="intro-actions" aria-label="Contact links">
          <a href={`mailto:${site.email}`}>Email</a>
          {
            site.social.github && (
              <a
                href={`https://github.com/${site.social.github}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
              </a>
            )
          }
          {
            site.social.linkedin && (
              <a
                href={`https://www.linkedin.com/in/${site.social.linkedin}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn
              </a>
            )
          }
        </div>
      </section>

      <section
        id="work-experience"
        class="about-section"
        aria-labelledby="work-experience-title"
      >
        <h2 id="work-experience-title">Work Experience</h2>

        <div class="timeline-list">
          {
            experience.map((item, index) => (
              <article class="timeline-item">
                <header class="timeline-header">
                  <h3>{item.data.company}</h3>
                  <span>
                    {item.data.startDate} - {item.data.endDate ?? "Present"}
                  </span>
                </header>

                <p class="role">{item.data.jobTitle}</p>

                <ul>
                  {item.data.bullets.slice(0, 2).map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>

                <div
                  class="chip-row"
                  aria-label={`${item.data.company} technologies`}
                >
                  {displayTools(item.data.techStack, item.data.tags)
                    .slice(0, 5)
                    .map((tool) => (
                      <span>{tool}</span>
                    ))}
                </div>

                <div class="media-row" aria-hidden="true">
                  <div class={`media-tile media-tile-${(index % 3) + 1}`} />
                  <div
                    class={`media-tile media-tile-${((index + 1) % 3) + 1}`}
                  />
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section
        id="studies"
        class="about-section"
        aria-labelledby="studies-title"
      >
        <h2 id="studies-title">Studies</h2>

        <div class="study-list">
          {
            studies.map((study) => (
              <article class="study-item">
                <h3>{study.title}</h3>
                <p>{study.meta}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section
        id="technical-skills"
        class="about-section"
        aria-labelledby="technical-skills-title"
      >
        <h2 id="technical-skills-title">Technical skills</h2>

        <div class="skill-list">
          {
            skills.map((skill, index) => (
              <article class="skill-item">
                <h3>{skill.title}</h3>
                <p>{skill.description}</p>

                <div class="chip-row" aria-label={`${skill.title} tools`}>
                  {skill.tools.map((tool) => (
                    <span>{tool}</span>
                  ))}
                </div>

                <div class="media-row media-row-large" aria-hidden="true">
                  <div class={`media-tile media-tile-${(index % 3) + 1}`} />
                  <div
                    class={`media-tile media-tile-${((index + 2) % 3) + 1}`}
                  />
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </article>
  </div>
</MainLayout>

<style>
  :global(.layout-wrapper) {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
          circle at 50% 0,
          color-mix(in srgb, var(--accent) 20%, transparent) 0 1px,
          transparent 1px 100%
        )
        0 0 / 18px 18px,
      var(--bg);
  }

  :global(.layout-wrapper)::before {
    content: "";
    position: fixed;
    inset: 0 0 auto;
    z-index: 0;
    height: 24rem;
    pointer-events: none;
    background: linear-gradient(180deg, var(--bg), transparent);
  }

  :global(.page-title) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  :global(.layout-wrapper > .container) {
    position: relative;
    z-index: 1;
    max-width: 1120px;
  }

  .about-shell {
    display: grid;
    grid-template-columns: minmax(8rem, 13rem) minmax(0, 44rem) minmax(
        0,
        13rem
      );
    gap: clamp(1.25rem, 4vw, 3rem);
    justify-content: center;
    padding-block: clamp(5rem, 10vw, 8rem) 4rem;
  }

  .about-rail {
    position: sticky;
    top: 8rem;
    align-self: start;
    padding-top: 0.25rem;
  }

  .about-rail nav {
    display: grid;
    gap: 0.25rem;
  }

  .about-rail a {
    width: fit-content;
    border-radius: 0.5rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.4;
    padding: 0.35rem 0.5rem;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .about-rail a:hover,
  .about-rail a:focus-visible {
    background: var(--surface-hover);
    color: var(--text);
    outline: none;
  }

  .about-page {
    display: grid;
    gap: 3.5rem;
    min-width: 0;
  }

  .about-section {
    scroll-margin-top: 7rem;
  }

  .about-intro {
    display: grid;
    gap: 1.5rem;
  }

  .identity-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .identity-row img {
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }

  .eyebrow,
  .location,
  .role,
  .study-item p,
  .skill-item p,
  .timeline-header span {
    margin: 0;
    color: var(--text-secondary);
  }

  .eyebrow {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 650;
  }

  .location,
  .timeline-header span,
  .role {
    font-size: 0.875rem;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 14ch;
    margin-bottom: 0;
    color: var(--text);
    font-size: clamp(3rem, 8vw, 5.9rem);
    font-weight: 760;
    letter-spacing: 0;
    line-height: 0.95;
    text-wrap: balance;
  }

  h2 {
    margin-bottom: 1.5rem;
    color: var(--text);
    font-size: 1rem;
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1.2;
  }

  h3 {
    margin-bottom: 0.25rem;
    color: var(--text);
    font-size: 1.2rem;
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .intro-copy {
    max-width: 42rem;
    margin-bottom: 0;
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .intro-actions,
  .chip-row,
  .media-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .intro-actions a,
  .chip-row span {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1;
    padding: 0.45rem 0.7rem;
    text-decoration: none;
  }

  .intro-actions a:hover,
  .intro-actions a:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    background: var(--surface-hover);
    outline: none;
  }

  .timeline-list,
  .study-list,
  .skill-list {
    display: grid;
    gap: 2rem;
  }

  .timeline-item,
  .study-item,
  .skill-item {
    display: grid;
    gap: 0.9rem;
  }

  .timeline-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .timeline-item ul {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding-left: 1.25rem;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.6;
  }

  .chip-row {
    padding-top: 0.25rem;
  }

  .chip-row span {
    min-height: 1.875rem;
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .media-row {
    padding-top: 0.35rem;
  }

  .media-tile {
    width: 6.75rem;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: 0.55rem;
    box-shadow: var(--shadow-sm);
  }

  .media-row-large .media-tile {
    width: 8rem;
  }

  .media-tile-1 {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.18), transparent 42%),
      linear-gradient(135deg, #182230, #244f5d);
  }

  .media-tile-2 {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.16), transparent 40%),
      linear-gradient(135deg, #261b30, #613042);
  }

  .media-tile-3 {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.15), transparent 42%),
      linear-gradient(135deg, #162318, #4d5836);
  }

  .study-item p,
  .skill-item p {
    font-size: 1rem;
    line-height: 1.6;
  }

  .skill-item p {
    max-width: 42rem;
  }

  @media (max-width: 900px) {
    .about-shell {
      grid-template-columns: minmax(0, 44rem);
      padding-block-start: 4.5rem;
    }

    .about-rail {
      display: none;
    }
  }

  @media (max-width: 640px) {
    :global(.layout-wrapper) {
      padding-block-start: 2rem;
    }

    .about-shell {
      padding-block-start: 5rem;
    }

    h1 {
      font-size: clamp(2.75rem, 18vw, 4.25rem);
    }

    .timeline-header {
      align-items: start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .media-tile,
    .media-row-large .media-tile {
      width: calc(50% - 0.25rem);
      min-width: 8rem;
    }
  }
</style>
