---
import { site } from "#config/site";
import { getProjects } from "#base/lib/content";
import SocialLinks from "./SocialLinks.astro";
import ProjectListItem from "./ProjectList/ProjectListItem.astro";

const featuredProjects = (await getProjects())
  .filter(({ data }) => data.featured)
  .slice(0, 2);
---

<section class="hero" aria-labelledby="home-heading">
  <div id="particles-js" class="hero-particles" aria-hidden="true"></div>
  <div class="hero-content container">
    <p class="eyebrow">Automation · Control systems · Software</p>
    <h1 id="home-heading">{site.username}</h1>
    <p class="hero-subtitle">{site.userTitle}</p>
    <p class="hero-description">{site.userDescription}</p>
    <ul class="focus-tags tag-list" aria-label="Engineering focus">
      {site.focusAreas.map((focus) => <li>{focus}</li>)}
    </ul>
    <div class="home-actions">
      <a class="action-link action-link--primary" href="/projects">
        Explore projects →
      </a>
      <a class="action-link" href="/about">Background & experience</a>
      <a class="action-link" href={"mailto:" + site.email}>Get in touch</a>
    </div>
    <SocialLinks />
  </div>
</section>

{featuredProjects.length > 0 && (
  <section class="home-section container" aria-labelledby="selected-projects-heading">
    <div class="section-header">
      <div class="section-heading">
        <p class="eyebrow">Personal projects</p>
        <h2 id="selected-projects-heading">Control systems in simulation</h2>
      </div>
      <a href="/projects">All projects →</a>
    </div>
    <div class="featured-projects">
      {featuredProjects.map((project) => (
        <ProjectListItem project={project} headingLevel="h3" />
      ))}
    </div>
  </section>
)}

<section class="home-section home-background container" aria-labelledby="background-heading">
  <h2 id="background-heading">Software delivery. Practical technical work.</h2>
  <p>
    My background combines software delivery for charities and university teams
    with hands-on work diagnosing and replacing technical equipment. These experiences
    support my focus on automation and integrated systems.
  </p>
  <a href="/about#work-experience">Read my professional experience →</a>
</section>

<script>
  import particlesConfig from "#assets/particles.json";
  import particlesUrl from "#assets/js/particles.min.js?url";

  interface ParticleInstance {
    pJS: {
      canvas: { el: HTMLCanvasElement };
      fn: { vendors: { destroypJS: () => void } };
    };
  }

  const particleWindow = window as Window & {
    particlesJS?: (id: string, config: unknown) => void;
    pJSDom?: ParticleInstance[] | null;
  };
  const host = document.getElementById("particles-js");
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let vendorReady: Promise<void> | undefined;
  let instance: ParticleInstance | undefined;

  const loadVendor = () => {
    if (particleWindow.particlesJS) return Promise.resolve();
    vendorReady ??= new Promise<void>((resolve) => {
      const script = document.createElement("script");
      script.src = particlesUrl;
      script.onload = () => resolve();
      script.onerror = () => resolve();
      document.head.appendChild(script);
    });
    return vendorReady;
  };

  const syncParticles = async () => {
    if (!host) return;
    if (motion.matches) {
      instance?.pJS.fn.vendors.destroypJS();
      instance = undefined;
      return;
    }

    await loadVendor();
    if (motion.matches || !host.isConnected || instance || !particleWindow.particlesJS) return;
    // The vendored destroy function clears this registry; restore it before restarting.
    particleWindow.pJSDom ??= [];
    particleWindow.particlesJS(host.id, particlesConfig);
    instance = particleWindow.pJSDom.find(({ pJS }) => pJS.canvas.el.parentElement === host);
  };

  motion.addEventListener("change", () => void syncParticles());
  void syncParticles();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg);
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.35;
  }

  .hero-particles :global(canvas) {
    display: block;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    min-height: 85svh;
    padding-block: calc(var(--header-offset) + var(--space-5)) var(--space-8);
    text-align: center;
  }

  h1 {
    font-size: var(--size-hero);
    line-height: 1.1;
  }

  .hero-subtitle {
    max-width: 40rem;
    font-size: var(--size-h3);
    line-height: var(--line-heading);
    text-wrap: balance;
  }

  .hero-description {
    max-width: var(--content-copy);
    color: var(--text-secondary);
    font-size: var(--size-lead);
  }

  .focus-tags,
  .home-actions {
    justify-content: center;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .home-section {
    padding-block: var(--section-gap);
  }

  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .featured-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .home-background {
    display: grid;
    gap: var(--space-5);
    padding-block-end: var(--space-8);
  }

  .home-background p {
    max-width: var(--content-copy);
    color: var(--text-secondary);
  }

  .home-background a {
    width: fit-content;
  }

  @media (max-width: 700px) {
    .featured-projects {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-particles {
      display: none;
    }
  }
</style>
