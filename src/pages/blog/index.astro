---
import { getBlogPath, getPublishedPosts } from "#base/lib/content";
import MainLayout from "#layouts/MainLayout.astro";

const posts = await getPublishedPosts();
---

<MainLayout
  title="Blog"
  description="Notes on automation, control systems, software, and engineering practice."
  contentWidth="text"
>
  <p class="page-intro">Notes on automation, control systems, software, and engineering practice.</p>
  {posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <article class="surface-card">
            <h2><a href={getBlogPath(post.id)}>{post.data.title}</a></h2>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("en-NZ", {
                year: "numeric",
                month: "short",
                day: "2-digit",
                timeZone: "UTC",
              })}
            </time>
            <p>{post.data.description}</p>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <div class="empty-state blog-empty">
      <p>No articles published yet. Engineering notes and project write-ups will appear here.</p>
      <a href="/projects">Explore projects →</a>
    </div>
  )}
</MainLayout>

<style>
  .post-list {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  article {
    display: grid;
    gap: var(--space-3);
    padding: var(--card-padding);
  }

  h2 {
    font-size: var(--size-h3);
  }

  time {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--size-sm);
  }

  article p {
    color: var(--text-secondary);
  }

  .blog-empty {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-left: var(--space-5);
    border-left: 1px solid var(--border-control);
  }
</style>
