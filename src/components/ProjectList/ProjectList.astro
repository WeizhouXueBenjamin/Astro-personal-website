---
import { getProjects } from "#base/lib/content";
import ProjectCard from "./ProjectCard.astro";

const projects = await getProjects();
---

{projects.length > 0 ? (
  <div class="project-list">
    {projects.map((project) => <ProjectCard project={project} layout="wide" />)}
  </div>
) : (
  <p class="empty-state">Project write-ups will appear here as they become available.</p>
)}

<style>
  .project-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
</style>
