---
export interface GlobalNavItemProps {
  href: string;
  title: string;
  description: string;
  icon: any;
  isActive?: boolean;
}

const { href, title, description, icon: Icon, isActive = false } = Astro.props;
---

<li class="toolbar-list-item">
  <a
    href={href}
    class:list={["toolbar-item", { "toolbar-item--active": isActive }]}
    aria-label={title}
    aria-current={isActive ? "page" : undefined}
  >
    <Icon class="icon" />
    <span class="toolbar-label">{title}</span>
  </a>
</li>

<style is:global>
  .toolbar-list-item {
    display: flex;
    align-items: stretch;
    padding: 0 0.25rem;
  }

  .toolbar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    text-decoration: none;
    color: #374151;
    transition: all 0.2s ease;
    font-size: 0.875rem;
  }

  @media (prefers-color-scheme: dark) {
    .toolbar-item {
      color: #e5e7eb;
    }
  }

  .toolbar-list-item:hover .toolbar-item,
  .toolbar-item:focus-visible {
    background: rgba(0, 0, 0, 0.05);
    transform: translateY(-2px);
  }

  .toolbar-item--active {
    background: rgba(79, 70, 229, 0.14);
    color: #4338ca;
  }

  @media (prefers-color-scheme: dark) {
    .toolbar-list-item:hover .toolbar-item,
    .toolbar-item:focus-visible {
      background: rgba(255, 255, 255, 0.1);
    }

    .toolbar-item--active {
      background: rgba(139, 156, 255, 0.18);
      color: #aebaff;
    }
  }

  .toolbar-list-item:hover .toolbar-item--active,
  .toolbar-item--active:focus-visible {
    background: rgba(79, 70, 229, 0.22);
    color: #312e81;
  }

  @media (prefers-color-scheme: dark) {
    .toolbar-list-item:hover .toolbar-item--active,
    .toolbar-item--active:focus-visible {
      background: rgba(139, 156, 255, 0.28);
      color: #d6dcff;
    }
  }

  .icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .toolbar-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  @media (max-width: 640px) {
    .floating-toolbar {
      padding: 0.5rem 0.75rem;
    }
    .toolbar-item {
      padding: 0.5rem 0.75rem;
    }
    .icon {
      width: 1.125rem;
      height: 1.125rem;
    }
  }
</style>
