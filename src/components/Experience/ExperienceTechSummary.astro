---
interface Technology {
  name: string;
  count: number;
  percentage: number;
}

interface Props {
  technologies: Technology[];
}

const { technologies } = Astro.props;
---

<section class="experience-section" aria-labelledby="tech-summary-heading">
  <div class="section-heading">
    <p>Tech Stack</p>
    <h2 id="tech-summary-heading">Technologies used across roles</h2>
  </div>

  <div class="tech-summary">
    {
      technologies.map((technology) => (
        <div class="tech-row">
          <div class="tech-label">
            <span>{technology.name}</span>
            <small>{technology.count} {technology.count === 1 ? "role" : "roles"}</small>
          </div>
          <div class="meter" aria-hidden="true">
            <span style={`width: ${technology.percentage}%`}></span>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .tech-summary {
    display: grid;
    gap: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--card);
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .tech-row {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }

  .tech-label {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }

  .tech-label span {
    color: var(--text);
    font-weight: 700;
  }

  small {
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .meter {
    height: 0.65rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--surface);
  }

  .meter span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), #2dd4bf, #fbbf24);
  }

  @media (max-width: 640px) {
    .tech-row {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }
</style>
