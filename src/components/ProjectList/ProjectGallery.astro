---
interface Props {
  layout?: "featured" | "comparison" | "sequence";
}

const { layout = "featured" } = Astro.props;
---

<div class:list={["project-gallery", `project-gallery--${layout}`]}>
  <slot />
</div>

<style>
  .project-gallery {
    display: grid;
    gap: var(--space-5);
  }

  .project-gallery--comparison {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-gallery > :global(*) {
    min-width: 0;
  }

  .project-gallery--sequence > :global(*) {
    padding-left: var(--space-4);
    border-left: 1px solid var(--border-control);
  }

  @media (max-width: 700px) {
    .project-gallery--comparison {
      grid-template-columns: 1fr;
    }
  }
</style>
